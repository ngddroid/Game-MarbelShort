<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MarbelShort" parent="android:Theme.Material.Light.NoActionBar">
        <!-- White, so the launch window flows straight into the white NG Studio intro without a purple flash. -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MarbelShort.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.MarbelShort</item>
    </style>
</resources>
